APP_NAME=ODF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# When running with docker compose the host is the service name "mysql".
# When running Laravel on your machine (php artisan serve) use 127.0.0.1 and port 3307.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=odf
DB_USERNAME=odf
DB_PASSWORD=odf_secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
